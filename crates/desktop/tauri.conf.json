{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Szept",
  "version": "0.1.0",
  "identifier": "org.szept.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Szept",
        "width": 400,
        "height": 680,
        "minWidth": 340,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "category": "SocialNetworking",
    "shortDescription": "Szyfrowany komunikator P2P bez kont i serwerów",
    "longDescription": "Szept łączy dwa urządzenia bezpośrednio i szyfruje rozmowę end-to-end. Nie wymaga konta ani numeru telefonu.",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["gstreamer1.0-plugins-good"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["Polish", "English"]
      }
    }
  }
}
